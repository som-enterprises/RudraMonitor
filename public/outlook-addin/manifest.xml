<?xml version="1.0" encoding="UTF-8"?>
<!--
  Event-based Outlook add-in — auto-inserts the org's centrally-managed
  signature on New / Reply / Forward compose events.

  Structure mirrors Microsoft's official signature-add-in sample at
  https://github.com/OfficeDev/Office-Add-in-samples/tree/main/Samples/outlook-set-signature

  Key differences from a "regular" add-in manifest:
    • Requirements set to Mailbox 1.13 (setSignatureAsync GA).
    • Two-resid Runtimes block (WebViewRuntime.Url + JSRuntime.Url) —
      Microsoft's validator rejects single-resid Runtimes.
    • Single LaunchEvent (OnNewMessageCompose) — the same event fires for
      New, Reply, Reply-All, and Forward compose scenarios.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">

  <Id>aff5a964-4e27-45ee-aeff-bbe0772511d5</Id>
  <Version>1.0.0.367</Version>
  <ProviderName>Wellness Extract</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Wellness Extract Signature" />
  <Description DefaultValue="Automatically inserts your organization's centrally-managed signature on new messages, replies, and forwards." />
  <IconUrl DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/icon-128.png" />
  <SupportUrl DefaultValue="https://ems.wellnessextract.com/employees/email-signatures" />

  <AppDomains>
    <AppDomain>https://api-ems.wellnessextract.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/commands.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
                    xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
                      xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.13">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <!-- Two-resid Runtimes: WebViewRuntime.Url is the HTML shell,
               JSRuntime.Url is the code. Microsoft's validator rejects the
               single-resid short form we tried earlier ("Failed" with no
               specific error). -->
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/icon-32.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/icon-128.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url"        DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/commands.html" />
          <bt:Url id="WebViewRuntime.Url"  DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/commands.html" />
          <bt:Url id="JSRuntime.Url"       DefaultValue="https://api-ems.wellnessextract.com/storage/v1/object/public/outlook-addin/commands.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel"           DefaultValue="Wellness Extract" />
          <bt:String id="OpenPaneButton.Label" DefaultValue="Insert signature" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="OpenPaneButton.Tooltip" DefaultValue="Manually insert the company signature." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
